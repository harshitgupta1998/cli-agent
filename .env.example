POSTGRES_DB=termind
POSTGRES_USER=termind
POSTGRES_PASSWORD=termind
DATABASE_URL=postgres://termind:termind@database:5432/termind?sslmode=disable
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
PLANNER_MODE=ollama
COMMAND_TIMEOUT_SECONDS=30
LOCAL_ONLY_MODE=true
CORS_ORIGIN=http://localhost:5173
VOICE_INPUT_ENABLED=false
VOICE_STT_PROVIDER=disabled
VOICE_STT_COMMAND=
VOICE_MAX_AUDIO_SECONDS=30
VOICE_MAX_AUDIO_BYTES=5242880
TERMIND_STT_MODEL=tiny.en
TERMIND_STT_MODEL_DIR=/models/whisper
TERMIND_STT_DEVICE=cpu
TERMIND_STT_COMPUTE_TYPE=int8
TERMIND_STT_LANGUAGE=en
